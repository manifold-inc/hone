{
    "spec_version": 1,
    "project": "genesis_moe",
    "model_size": "8B-A1B",

    "tokenizer_name": "google/gemma-2-2b",
    "sequence_length": 4096,
    "micro_batch_size": 4,
    "target_batch_size": 1024,
    "batch_size": 16,
    "inner_steps": 30,
    "max_inner_steps": 300,
    "outer_learning_rate": 0.4,
    "weight_decay": 0.1,
    "max_grad_norm": 1.0,

    "blocks_per_window": 26,
    "windows_per_weights": 3,
    "outer_steps_per_shard": 455,
    "momentum_decay": 0.999,
    "momentum_subtraction_alpha": 0.2,
    "topk_compression": 32,
    "target_chunk": 64,
    "use_dct": true,

    "validator_offset": 1,
    "checkpoint_frequency": 10,
    "gather_peer_count": 20,
    "gather_share": 0.75,
    "gather_top_ratio": 2.0,
    "reserve_peer_count": 10,
    "reserve_decay_ratio": 0.5,
    "minimum_peers": 1,
    "peer_replacement_frequency": 2,
    "peer_list_window_margin": 1,
    "active_check_interval": 100,
    "recent_windows": 2,
    "power_normalisation": 2.0,
    "validator_sample_micro_bs": 8,
    "gather_peers_slash_threshold": 0.4,
    "uids_per_window": 20,
    "time_window_delta_seconds": 70,
    "reset_inactivity_windows": 3,
    "sync_max_steps_behind": 2,
    "binary_score_ma_alpha": 0.05,
    "bma_threshold": 0.10,
    "bma_warmup_windows": 10,
    "missing_gradient_penalty_score": -99.0,
    "openskill_beta": 7,
    "openskill_tau": 0.1,
    "num_evaluation_bins": 5,
    "quantization_bins": 4,
    "quantization_range": 6,
    "incentive_burn_rate": 1.0,
    "idx_overlap_threshold": 0.4,
    "consecutive_negative_threshold": 3,
    "exclude_negative_peers": true,
    "eval_lr_factor": 0.5,

    "optimizer": {
        "type": "muon",
        "adamw": {
            "betas": [0.9, 0.95],
            "eps": 1e-8,
            "weight_decay": 0.1,
            "learning_rate": 3e-4,
            "scheduler": {
                "warmup_steps": 1000,
                "warmup_inner_steps": 30,
                "t_max": 140000,
                "eta_min_factor": 0.1
            }
        },
        "muon": {
            "momentum": 0.95,
            "weight_decay": 0.01,
            "head_lr_scale": 0.2,
            "embed_lr_scale": 0.2,
            "scalar_lr_scale": 0.2,
            "learning_rate": 2e-3,
            "scheduler": {
                "warmup_steps": 1000,
                "warmup_inner_steps": 30,
                "t_max": 140000,
                "eta_min_factor": 0.1
            }
        }
    },

    "offload_optimizer_states": true,
    "fsdp": {
        "dp_shard": 2,
        "compile": false,
        "mixed_precision": "bfloat16"
    },

    "pipeline": {
        "enabled": true,
        "num_stages": 2,
        "bottleneck_dim": 16
    }
}
