{
    "spec_version": 1,
    "project": "genesis_moe",
    "model_size": "8B-A1B",

    "tokenizer_name": "google/gemma-2-2b",
    "sequence_length": 4096,
    "micro_batch_size": 4,
    "target_batch_size": 1024,
    "batch_size": 256,
    "inner_steps": 4,
    "max_inner_steps": 15,
    "outer_learning_rate": 0.4,
    "outer_momentum": 0.95,
    "outer_nesterov": false,
    "outer_max_grad_norm": 50.0,
    "outer_grad_norm_auto": true,
    "outer_grad_norm_auto_factor": 1.5,
    "outer_grad_norm_ema_decay": 0.95,
    "outer_lr_schedule": "cosine",
    "outer_lr_t_max": 3000,
    "outer_lr_min_factor": 0.1,
    "reset_inner_optimizer_per_window": 0.2,
    "reset_warmup_per_window": false,
    "weight_decay": 0.1,
    "max_grad_norm": 1.0,
    "blocks_per_window": 10,
    "windows_per_weights": 9,
    "outer_steps_per_shard": 455,
    "momentum_decay": 0.999,
    "momentum_subtraction_alpha": 0.2,
    "topk_compression": 32,
    "target_chunk": 64,
    "use_dct": true,

    "validator_offset": 1,
    "checkpoint_frequency": 10,
    "gather_peer_count": 20,
    "gather_share": 0.75,
    "gather_top_ratio": 2.0,
    "reserve_peer_count": 10,
    "reserve_decay_ratio": 0.5,
    "minimum_peers": 1,
    "peer_replacement_frequency": 6,
    "peer_list_window_margin": 3,
    "active_check_interval": 100,
    "recent_windows": 6,
    "power_normalisation": 2.0,
    "validator_sample_micro_bs": 8,
    "gather_peers_slash_threshold": 0.4,
    "uids_per_window": 20,
    "time_window_delta_seconds": 30,
    "window_flush_headroom_seconds": 20,
    "reset_inactivity_windows": 9,
    "sync_max_steps_behind": 2,
    "binary_score_ma_alpha": 0.05,
    "bma_threshold": 0.10,
    "bma_warmup_windows": 30,
    "missing_gradient_penalty_score": -99.0,
    "openskill_beta": 7,
    "openskill_tau": 0.1,
    "num_evaluation_bins": 5,
    "quantization_bins": 4,
    "quantization_range": 6,
    "incentive_burn_rate": 1.0,
    "idx_overlap_threshold": 0.4,
    "consecutive_negative_threshold": 3,
    "exclude_negative_peers": true,
    "eval_lr_factor": 0.5,

    "optimizer": {
        "type": "muon",
        "adamw": {
            "betas": [0.9, 0.95],
            "eps": 1e-8,
            "weight_decay": 0.1,
            "learning_rate": 3e-4,
            "boundary_lr_scale": 0.1,
            "scheduler": {
                "warmup_steps": 1000,
                "warmup_inner_steps": 30,
                "t_max": 140000,
                "eta_min_factor": 0.1
            }
        },
        "muon": {
            "momentum": 0.95,
            "weight_decay": 0.01,
            "head_lr_scale": 0.2,
            "embed_lr_scale": 0.2,
            "scalar_lr_scale": 0.2,
            "boundary_lr_scale": 0.1,
            "learning_rate": 2e-3,
            "scheduler": {
                "warmup_steps": 1000,
                "warmup_inner_steps": 30,
                "t_max": 140000,
                "eta_min_factor": 0.1
            }
        }
    },

    "offload_optimizer_states": true,
    "fsdp": {
        "dp_shard": 4,
        "compile": true,
        "mixed_precision": "bfloat16",
        "activation_checkpoint": "selective"
    },

    "pipeline": {
        "enabled": true,
        "num_stages": 2,
        "bottleneck_dim": 128,
        "identity_reg_coeff": 1e-3
    },

    "pp_transport": {
        "async_send": true,
        "send_queue_depth": 2,
        "intra_node_nccl": false
    },

    "dataloader": {
        "num_workers": 4,
        "pin_memory": true,
        "persistent_workers": true,
        "prefetch_factor": 4
    }
}
