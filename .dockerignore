# What NOT to send to the docker daemon as build context.
#
# The build context is the entire ``hone/`` directory (compose's
# ``context: ..`` resolves there from ``hone/docker/``). Without this
# file every dataset shard, virtualenv, log file and checkpoint in
# the host tree gets streamed to the daemon -- we caught it shipping
# ~85 GiB per service in one run, before this file existed.
#
# Anything listed here is excluded from BOTH the implicit "load
# build context" step and any ``COPY``-time copies. The runtime
# bind-mount in docker-compose.yml (``../:/app:rw``) is unaffected;
# it brings the host source tree into the running container at /app.

# ────────────────────────────────────────────────────────────────────
# Datasets / model artefacts (the typical 10s-of-GiB offenders)
# ────────────────────────────────────────────────────────────────────
tokenized/
tokenized_*/
data/
datasets/
checkpoints/
models/
wandb/
runs/
outputs/
artifacts/
*.npy
*.bin
*.pt
*.safetensors
*.ckpt
*.tar
*.tar.gz
*.tgz
*.zip
*.7z

# ────────────────────────────────────────────────────────────────────
# Local Python venv + caches (we build a fresh /app/.venv inside the
# image, the host's is irrelevant and ~700 MiB)
# ────────────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.tox/
build/
dist/

# ────────────────────────────────────────────────────────────────────
# Logs from prior runs (often hundreds of MiB)
# ────────────────────────────────────────────────────────────────────
log/
logs/
*.log
*.output
miner-stage-*.output
validator-log.output
miner-log.output
docker/logs/

# ────────────────────────────────────────────────────────────────────
# Source-control / editor / OS noise
# ────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.github/
.idea/
.vscode/
.cursor/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ────────────────────────────────────────────────────────────────────
# Local secrets shouldn't end up baked into the image -- they're
# already injected via docker-compose environment: blocks at runtime
# ────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ────────────────────────────────────────────────────────────────────
# Bind-mounted log directory under docker/logs (the compose file
# mounts it read-write at /app/logs, no reason to bake it in)
# ────────────────────────────────────────────────────────────────────
docker/logs/

# Per-host docker/.env (already covered by .env.* above but stated
# explicitly here so future readers don't re-add it).
docker/.env
