# Hone docker-compose environment.
# Copy to .env and fill in. Anything blank uses the docker-compose default.

# ────────────────────────────────────────────────────────────────────
# Bittensor wallet identities
# ────────────────────────────────────────────────────────────────────

# Validator wallet. Must be the registered validator hotkey on `NETUID`.
VALIDATOR_WALLET_NAME=hone-validator
VALIDATOR_WALLET_HOTKEY=default

# Miner wallet. Every PP-stage container shares this hotkey -- the
# subnet sees one UID per (cold, hot) pair, and per-stage gradient
# files are namespaced on R2 by the ``-stage{N}`` suffix the upload
# path adds when ``stage_id`` is set, so they don't clobber each other.
MINER_WALLET_NAME=hone-miner
MINER_WALLET_HOTKEY=default

# Path on the host to your bittensor wallet directory. Mounted read-only
# into every container at /root/.bittensor/wallets.
BITTENSOR_WALLETS_DIR=~/.bittensor/wallets

# Optional: HuggingFace cache directory on host. Mounted into every
# container so tokenizers / models aren't re-downloaded per service.
HF_CACHE_DIR=~/.cache/huggingface

# ────────────────────────────────────────────────────────────────────
# GPU layout
# ────────────────────────────────────────────────────────────────────
# Each container's GPUs come from NVIDIA_VISIBLE_DEVICES (CSV) and
# the matching NPROC value drives torchrun -- one rank per GPU.
#
# IMPORTANT constraints on NPROC values:
#
# 1. ``MINER_S*_NPROC`` MUST all be equal across stages. The PP
#    transport pairs ranks 1-to-1 across stages (stage K rank R
#    connects to stage K+1 rank R) and the data sampler slices
#    each window by ``rank :: world_size``. Asymmetric NPROC hangs
#    extra ranks on accept() and desyncs the data each stage sees
#    (stage K+1's labels would not match stage K's input_ids).
#
# 2. Each NPROC must DIVIDE the model's hidden_dim. FSDP pads when
#    the dim isn't divisible, and the padded full shape then
#    mismatches the original param shape during
#    ``restore_offloaded_params``. For hidden_dim=2048, valid NPROC
#    values are {1, 2, 4, 8}.
#
# 8-GPU default: 1 validator + 3-stage pipeline, NPROC=2 everywhere
# (power of 2, divides 2048 cleanly). 24 transformer layers / 3
# stages = 8 layers per stage.
VALIDATOR_GPU_IDS=0,1
VALIDATOR_NPROC=2

MINER_S0_GPU_IDS=2,3
MINER_S0_NPROC=2

MINER_S1_GPU_IDS=4,5
MINER_S1_NPROC=2

MINER_S2_GPU_IDS=6,7
MINER_S2_NPROC=2

# ────────────────────────────────────────────────────────────────────
# Pipeline parallelism
# ────────────────────────────────────────────────────────────────────
# Number of pipeline stages. Must match ``pipeline.num_stages`` in
# ``hparams/hparams.json``. The shipped compose file defines services
# for stages 0, 1, 2; if you bump this past 3, add matching
# ``miner-s{N}:`` blocks to docker-compose.yml.
PP_NUM_STAGES=3

# ────────────────────────────────────────────────────────────────────
# Chain config
# ────────────────────────────────────────────────────────────────────

NETUID=5
SUBTENSOR_NETWORK=finney
# Optional: override chain endpoint (e.g. mainnet mirror, local
# subtensor for testing). Leave blank to use the network default.
SUBTENSOR_CHAIN_ENDPOINT=

# ────────────────────────────────────────────────────────────────────
# R2 / S3 buckets
# ────────────────────────────────────────────────────────────────────
# Pulled directly from hone/.env.example. Gradients bucket is required;
# aggregator bucket is only used by validators (safe to leave blank for
# miner-only deployments). Dataset bucket is required for both.

R2_GRADIENTS_ACCOUNT_ID=
R2_GRADIENTS_BUCKET_NAME=
R2_GRADIENTS_READ_ACCESS_KEY_ID=
R2_GRADIENTS_READ_SECRET_ACCESS_KEY=
R2_GRADIENTS_WRITE_ACCESS_KEY_ID=
R2_GRADIENTS_WRITE_SECRET_ACCESS_KEY=

R2_AGGREGATOR_ACCOUNT_ID=
R2_AGGREGATOR_BUCKET_NAME=
R2_AGGREGATOR_READ_ACCESS_KEY_ID=
R2_AGGREGATOR_READ_SECRET_ACCESS_KEY=
R2_AGGREGATOR_WRITE_ACCESS_KEY_ID=
R2_AGGREGATOR_WRITE_SECRET_ACCESS_KEY=

R2_DATASET_ACCOUNT_ID=
R2_DATASET_BUCKET_NAME=
R2_DATASET_READ_ACCESS_KEY_ID=
R2_DATASET_READ_SECRET_ACCESS_KEY=
DATASET_BINS_PATH=tokenized/

# ────────────────────────────────────────────────────────────────────
# Optional integrations
# ────────────────────────────────────────────────────────────────────

WANDB_API_KEY=
HF_TOKEN=
DASHBOARD_API_URL=https://api.hone.training
DASHBOARD_API_KEY=

# ────────────────────────────────────────────────────────────────────
# Per-service flag overrides (passed through verbatim)
# ────────────────────────────────────────────────────────────────────
# Append any miner.py / validator.py CLI flag here. Common ones:
#   --debug         verbose logging
#   --trace         trace logging
#   --test          treat all metagraph UIDs as eligible peers
VALIDATOR_EXTRA_FLAGS=
MINER_EXTRA_FLAGS=
